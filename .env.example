# ─────────────────────────────────────────────────────────────────────────────
# Voice ERP kit — the ONE config file for api, ai and web (Docker or local).
# Copy to .env (`make setup` does it), fill in your keys, restart (`make restart`).
# Everything works with the mock providers: no key needed to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your company's data ──
# Your team zip ships it in ./data (seed/ + context/). Relative paths are resolved from this repo's root.
DATA_DIR=./data

# ── Ports on your machine ──
# ERP UI → http://localhost:5173
WEB_PORT=5173
# ERP REST API (+ /api/events/stream)
API_PORT=4000
# AI service: /chat, /command, WS /voice
AI_PORT=4100
# Where the AI service reaches the ERP (local mode; Docker sets it for you)
ERP_API_URL=http://localhost:4000

# ── LLM ──
# provider: openai | anthropic | gemini | openai-compatible | mock
#   openai-compatible = any OpenAI-style endpoint (Groq, Together, vLLM, Ollama…): set LLM_BASE_URL
LLM_PROVIDER=mock
# Anthropic models: claude-sonnet-5-5 (default, balanced) · claude-haiku-5-5 (fastest, cheapest) · claude-opus-5-5 (smartest, slower)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Anthropic only (output_config.effort): low | medium | high — low keeps voice latency down; empty = model default
LLM_EFFORT=low
# Outbound calls: the small model for the simple turns Jev recognised (refusal, yes to the recap, goodbye…).
# Empty = the provider small model (anthropic: claude-haiku-5-5). Set it to LLM_MODEL to use one model everywhere.
LLM_FAST_MODEL=
# max model ↔ tool round-trips per turn
AGENT_MAX_STEPS=8

# ── Jev (TypeSafe AI decision model) — optional, used NEXT to the LLM, not instead of it ──
# Not a chat model: it answers typed questions (choice / score / yes-no) with probabilities, fast.
# For routing, "which product did the caller mean", yes/no confirmation… See apps/ai/README.md "Jev".
# Empty key → get_jev_client() returns None and nothing changes.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── Hands-free calls: who speaks when (apps/ai/app/services/turn_taking.py) ──
# « euh », « hum », « bah » never count as words: alone they are not a turn and never cut the agent.
# Silence that ends a normal sentence (ms):
VOICE_SILENCE_MS=600
# Silence tolerated when the sentence is clearly unfinished (« je voudrais… euh », « des moules et ») (ms):
VOICE_HOLD_MS=2500
# Real words (hesitations excluded) needed to interrupt the agent while it speaks:
VOICE_BARGE_IN_WORDS=2
# 1 = « oui », « d'accord », « mmh » while the agent speaks let it go on (taken as an answer only over its final question)
VOICE_IGNORE_BACKCHANNEL=1
# Caller silent this long (s) after the agent spoke: one short relaunch « Vous êtes toujours là ? » (0 = never)
VOICE_REPROMPT_S=0
# After the agent's audio stops, its own words heard back through the mic are still ignored this long (ms):
VOICE_ECHO_TAIL_MS=800
# Jev: below this probability the caller was talking to someone next to him (« Kevin, sors les poubelles ! »):
# the agent says nothing (and resumes its sentence if it was cut). 0 = always answer.
VOICE_ADDRESSEE_MIN=0.5
# Callbacks (« rappelez-moi demain à 15 h »): with the phone (Twilio) set up, it rings by itself at that time.
# Only callbacks due for less than VOICE_CALLBACK_WINDOW_MIN minutes ring by themselves (older ones: by hand).
VOICE_CALLBACK_AUTO=1
VOICE_CALLBACK_WINDOW_MIN=15
# Not understood → the agent asks (reusing what it understood), never guesses. Jev's « clear » probability below
# VOICE_CLARITY_MIN, or Soniox's mean word confidence below VOICE_STT_CONFIDENCE_MIN while Jev is not sure either.
VOICE_CLARITY_MIN=0.4
VOICE_STT_CONFIDENCE_MIN=0.6
# ── Speech-to-text ── provider: deepgram | soniox | gradium | openai | mock
#   deepgram  model nova-3 (default; French via STT_LANGUAGE=fr)        https://console.deepgram.com
#   soniox    model stt-rt-v6 (default; real-time WebSocket, webm OK)   https://console.soniox.com
#   gradium   model default (browser webm is re-wrapped to ogg; Safari mp4 not accepted)  https://gradium.ai
#   openai    model gpt-4o-mini-transcribe
# The browser records audio/webm;codecs=opus: all four accept it.
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=fr

# ── Text-to-speech ── provider: elevenlabs | gradium | openai | mock (mock = the browser speaks)
#   elevenlabs  model eleven_flash_v2_5 (default, ~160 ms to first audio; eleven_v4_turbo ~230 ms, more expressive;
#               eleven_v4 ~850 ms: too slow live). Compare by ear: python -m app.eval_tts
#               voice JBFqnCBsd6RMkjVDRZzb (default, multilingual) — pick a French voice in your ElevenLabs library
#   gradium     model default; voice F7Iib4MAyHIRed0x (default: Armand, fr-FR, masculine)
#               other fr-FR voices: 0fvH6XAKvA748v2v (Tiphaine), vMYQUSzm6GRkJX6d (Olivier), J4XbCGPYNMigXcfZ (Amélie)
#   openai      model gpt-4o-mini-tts, voice alloy
# Every provider streams mp3 to the browser (Gradium's PCM is encoded to mp3 on the fly).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_LANGUAGE=fr

# ── Phone calls (Twilio) — optional: the agent rings YOUR phone for an outbound call ──
# Step by step: GUIDE-TELEPHONE.md. All five set → a "Sur mon téléphone" button on the call bar (Voix page).
# Needs STT_PROVIDER=soniox and TTS_PROVIDER=elevenlabs (or gradium).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# your Twilio number, international format: +1…, +33…
TWILIO_FROM_NUMBER=
# the ONLY number the agent ever calls (your phone), international format: +336…
TWILIO_TO_NUMBER=
# the https address of your tunnel to the AI service (ngrok http 4100 / cloudflared), no trailing slash
PUBLIC_URL=
# Twilio hangs up after this many seconds, whatever happens
TWILIO_MAX_CALL_S=300
